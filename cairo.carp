  (doc set-dash
    "Set the dash pattern. `dashes` is an array of on/off lengths; `offset` shifts the pattern start.")
  (deftemplate set-dash
               (Fn [(Ptr CairoContext) (Ref (Array Double)) Double] ())
               "void $NAME(cairo_t *cr, Array *dashes, double offset)"
               "$DECL { cairo_set_dash(cr, (double*)dashes->data, dashes->len, offset); }")
  (doc get-dash-count
    "Return the number of dash segments in the current dash pattern (0 means solid).")
  (register get-dash-count (Fn [(Ptr CairoContext)] Int) "cairo_get_dash_count")
  (doc get-dash "Return the current dash pattern as an array of doubles.")
  (deftemplate get-dash
               (Fn [(Ptr CairoContext)] (Array Double))
               "Array $NAME(cairo_t *cr)"
               "$DECL { int n = cairo_get_dash_count(cr); Array a; a.len = n; a.capacity = n; if (n > 0) { a.data = CARP_MALLOC(n * sizeof(double)); cairo_get_dash(cr, (double*)a.data, NULL); } else { a.data = NULL; } return a; }")
  (doc get-dash-offset
    "Return the offset into the dash pattern set by `set-dash`.")
  (deftemplate get-dash-offset
               (Fn [(Ptr CairoContext)] Double)
               "double $NAME(cairo_t *cr)"
               "$DECL { double offset; cairo_get_dash(cr, NULL, &offset); return offset; }")

