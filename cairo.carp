  ; --- Scaled fonts ---

  (doc scaled-font-create
    "Scale `face` by the font matrix `fm` — usually `(matrix-init-scale size size)` — under the transformation `ctm`, using Cairo's default font options. Must be paired with `scaled-font-destroy`.")
  (deftemplate scaled-font-create
               (Fn
                 [(Ptr CairoFontFace) (Ref CairoMatrix) (Ref CairoMatrix)]
                 (Ptr CairoScaledFont))
               "cairo_scaled_font_t* $NAME(cairo_font_face_t *f, CairoMatrix *fm, CairoMatrix *ctm)"
               "$DECL { cairo_matrix_t cfm = {.xx = fm->xx, .yx = fm->yx, .xy = fm->xy, .yy = fm->yy, .x0 = fm->x0, .y0 = fm->y0}; cairo_matrix_t cctm = {.xx = ctm->xx, .yx = ctm->yx, .xy = ctm->xy, .yy = ctm->yy, .x0 = ctm->x0, .y0 = ctm->y0}; cairo_font_options_t *o = cairo_font_options_create(); cairo_scaled_font_t *sf = cairo_scaled_font_create(f, &cfm, &cctm, o); cairo_font_options_destroy(o); return sf; }")
  (doc scaled-font-destroy
    "Drop a reference to a scaled font. Pairs with `scaled-font-create`.")
  (register scaled-font-destroy
    (Fn [(Ptr CairoScaledFont)] ())
    "cairo_scaled_font_destroy")
  (register scaled-font-status
    (Fn [(Ptr CairoScaledFont)] CairoStatus)
    "cairo_scaled_font_status")
  (doc get-scaled-font
    "Return the scaled font the context would use for text right now, combining its font face, size, and transformation. The context keeps ownership.")
  (register get-scaled-font
    (Fn [(Ptr CairoContext)] (Ptr CairoScaledFont))
    "cairo_get_scaled_font")
  (doc set-scaled-font
    "Use `sf` for subsequent text operations, replacing the context's font face, size, and font matrix.")
  (register set-scaled-font
    (Fn [(Ptr CairoContext) (Ptr CairoScaledFont)] ())
    "cairo_set_scaled_font")
  (doc scaled-font-extents
    "Return the metrics of a scaled font, the way `font-extents` does for a context's current font.")
  (deftemplate scaled-font-extents
               (Fn [(Ptr CairoScaledFont)] CairoFontExtents)
               "CairoFontExtents $NAME(cairo_scaled_font_t *sf)"
               "$DECL { cairo_font_extents_t cf; cairo_scaled_font_extents(sf, &cf); CairoFontExtents e; e.ascent = cf.ascent; e.descent = cf.descent; e.height = cf.height; e.max_MINUS_x_MINUS_advance = cf.max_x_advance; e.max_MINUS_y_MINUS_advance = cf.max_y_advance; return e; }")
  (doc scaled-font-text-extents
    "Measure `text` in a scaled font, the way `text-extents` does for a context's current font.")
  (deftemplate scaled-font-text-extents
               (Fn [(Ptr CairoScaledFont) (Ptr CChar)] CairoTextExtents)
               "CairoTextExtents $NAME(cairo_scaled_font_t *sf, const char *text)"
               "$DECL { cairo_text_extents_t ct; cairo_scaled_font_text_extents(sf, text, &ct); CairoTextExtents e; e.x_MINUS_bearing = ct.x_bearing; e.y_MINUS_bearing = ct.y_bearing; e.width = ct.width; e.height = ct.height; e.x_MINUS_advance = ct.x_advance; e.y_MINUS_advance = ct.y_advance; return e; }")

  ; --- Glyphs ---

  (doc show-glyphs
    "Draw `glyphs` with the current source, leaving the current point after the last one.")
  (deftemplate show-glyphs
               (Fn [(Ptr CairoContext) (Ref (Array CairoGlyph))] ())
               "void $NAME(cairo_t *cr, Array *glyphs)"
               "$DECL { int n = glyphs->len; cairo_glyph_t *g = cairo_glyph_allocate(n); CairoGlyph *src = (CairoGlyph*)glyphs->data; for (int i = 0; i < n; i++) { g[i].index = (unsigned long)src[i].index; g[i].x = src[i].x; g[i].y = src[i].y; } cairo_show_glyphs(cr, g, n); cairo_glyph_free(g); }")
  (doc glyph-path
    "Append the outlines of `glyphs` to the current path, so they can be filled, stroked, or clipped with.")
  (deftemplate glyph-path
               (Fn [(Ptr CairoContext) (Ref (Array CairoGlyph))] ())
               "void $NAME(cairo_t *cr, Array *glyphs)"
               "$DECL { int n = glyphs->len; cairo_glyph_t *g = cairo_glyph_allocate(n); CairoGlyph *src = (CairoGlyph*)glyphs->data; for (int i = 0; i < n; i++) { g[i].index = (unsigned long)src[i].index; g[i].x = src[i].x; g[i].y = src[i].y; } cairo_glyph_path(cr, g, n); cairo_glyph_free(g); }")
  (doc glyph-extents
    "Measure `glyphs` in the context's current font. Bearings and advances are relative to the first glyph's origin.")
  (deftemplate glyph-extents
               (Fn
                 [(Ptr CairoContext) (Ref (Array CairoGlyph))]
                 CairoTextExtents)
               "CairoTextExtents $NAME(cairo_t *cr, Array *glyphs)"
               "$DECL { int n = glyphs->len; cairo_glyph_t *g = cairo_glyph_allocate(n); CairoGlyph *src = (CairoGlyph*)glyphs->data; for (int i = 0; i < n; i++) { g[i].index = (unsigned long)src[i].index; g[i].x = src[i].x; g[i].y = src[i].y; } cairo_text_extents_t ct; cairo_glyph_extents(cr, g, n, &ct); cairo_glyph_free(g); CairoTextExtents e; e.x_MINUS_bearing = ct.x_bearing; e.y_MINUS_bearing = ct.y_bearing; e.width = ct.width; e.height = ct.height; e.x_MINUS_advance = ct.x_advance; e.y_MINUS_advance = ct.y_advance; return e; }")
  (doc scaled-font-glyph-extents
    "Measure `glyphs` in a scaled font, without needing a context.")
  (deftemplate scaled-font-glyph-extents
               (Fn
                 [(Ptr CairoScaledFont) (Ref (Array CairoGlyph))]
                 CairoTextExtents)
               "CairoTextExtents $NAME(cairo_scaled_font_t *sf, Array *glyphs)"
               "$DECL { int n = glyphs->len; cairo_glyph_t *g = cairo_glyph_allocate(n); CairoGlyph *src = (CairoGlyph*)glyphs->data; for (int i = 0; i < n; i++) { g[i].index = (unsigned long)src[i].index; g[i].x = src[i].x; g[i].y = src[i].y; } cairo_text_extents_t ct; cairo_scaled_font_glyph_extents(sf, g, n, &ct); cairo_glyph_free(g); CairoTextExtents e; e.x_MINUS_bearing = ct.x_bearing; e.y_MINUS_bearing = ct.y_bearing; e.width = ct.width; e.height = ct.height; e.x_MINUS_advance = ct.x_advance; e.y_MINUS_advance = ct.y_advance; return e; }")

  (private text-to-glyphs!)
  (hidden text-to-glyphs!)
  (deftemplate text-to-glyphs!
               (Fn
                 [(Ptr CairoScaledFont)
                  Double
                  Double
                  (Ptr CChar)
                  (Ref CairoStatus)]
                 (Array CairoGlyph))
               "Array $NAME(cairo_scaled_font_t *sf, double x, double y, const char *text, cairo_status_t *st)"
               "$DECL { cairo_glyph_t *g = NULL; int n = 0; Array a = {.len = 0, .capacity = 0, .data = NULL}; *st = cairo_scaled_font_text_to_glyphs(sf, x, y, text, -1, &g, &n, NULL, NULL, NULL); if (*st == CAIRO_STATUS_SUCCESS && n > 0) { a.len = n; a.capacity = n; a.data = CARP_MALLOC(n * sizeof(CairoGlyph)); CairoGlyph *dst = (CairoGlyph*)a.data; for (int i = 0; i < n; i++) { dst[i].index = (Long)g[i].index; dst[i].x = g[i].x; dst[i].y = g[i].y; } } cairo_glyph_free(g); return a; }")
  (doc scaled-font-text-to-glyphs
    "Lay `text` out in a scaled font starting at `(x y)`, returning the glyphs it maps to, or the failing status in the error branch.

The glyphs are copied out of Cairo's allocation, so the result is an ordinary Carp array and can be handed straight to `show-glyphs`.")
  (defn scaled-font-text-to-glyphs [sf x y text]
    (let-do [s status-success
             glyphs (text-to-glyphs! sf x y text &s)]
      (if (success? s) (Result.Success glyphs) (Result.Error s))))

  ; --- Pattern / gradient bindings ---

  (register extend-none CairoExtend "CAIRO_EXTEND_NONE")
  (register extend-repeat CairoExtend "CAIRO_EXTEND_REPEAT")
  (register extend-reflect CairoExtend "CAIRO_EXTEND_REFLECT")
  (register extend-pad CairoExtend "CAIRO_EXTEND_PAD")

  (register filter-fast CairoFilter "CAIRO_FILTER_FAST")
  (register filter-good CairoFilter "CAIRO_FILTER_GOOD")
  (register filter-best CairoFilter "CAIRO_FILTER_BEST")
  (register filter-nearest CairoFilter "CAIRO_FILTER_NEAREST")
  (register filter-bilinear CairoFilter "CAIRO_FILTER_BILINEAR")

  (doc pattern-create-linear
