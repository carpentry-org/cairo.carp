  (register pattern-create-for-surface
    (Fn [(Ptr CairoSurface)] (Ptr CairoPattern))
    "cairo_pattern_create_for_surface")

  (doc pattern-add-color-stop-rgb
    "Add an opaque color stop at `offset` (0.0–1.0) to a gradient pattern.")
  (register pattern-add-color-stop-rgb
    (Fn [(Ptr CairoPattern) Double Double Double Double] ())
    "cairo_pattern_add_color_stop_rgb")
  (doc pattern-add-color-stop-rgba
    "Add a translucent color stop at `offset` (0.0–1.0) to a gradient pattern.")
  (register pattern-add-color-stop-rgba
    (Fn [(Ptr CairoPattern) Double Double Double Double Double] ())
    "cairo_pattern_add_color_stop_rgba")

  (doc set-source
    "Set the pattern as the source for subsequent drawing operations.")
  (register set-source
    (Fn [(Ptr CairoContext) (Ptr CairoPattern)] ())
    "cairo_set_source")

  (register pattern-set-extend
    (Fn [(Ptr CairoPattern) CairoExtend] ())
    "cairo_pattern_set_extend")
  (register pattern-get-extend
    (Fn [(Ptr CairoPattern)] CairoExtend)
    "cairo_pattern_get_extend")
  (doc pattern-set-matrix
    "Set the pattern's matrix, which maps user space to pattern space — the inverse of how the pattern moves on the surface.")
  (deftemplate pattern-set-matrix
               (Fn [(Ptr CairoPattern) (Ref CairoMatrix)] ())
               "void $NAME(cairo_pattern_t *pat, CairoMatrix *m)"
               "$DECL { cairo_matrix_t cm = {.xx = m->xx, .yx = m->yx, .xy = m->xy, .yy = m->yy, .x0 = m->x0, .y0 = m->y0}; cairo_pattern_set_matrix(pat, &cm); }")
  (doc pattern-get-matrix "Return the pattern's current matrix.")
  (deftemplate pattern-get-matrix
               (Fn [(Ptr CairoPattern)] CairoMatrix)
               "CairoMatrix $NAME(cairo_pattern_t *pat)"
               "$DECL { cairo_matrix_t cm; cairo_pattern_get_matrix(pat, &cm); CairoMatrix r = {.xx = cm.xx, .yx = cm.yx, .xy = cm.xy, .yy = cm.yy, .x0 = cm.x0, .y0 = cm.y0}; return r; }")

  (register pattern-set-filter
    (Fn [(Ptr CairoPattern) CairoFilter] ())
    "cairo_pattern_set_filter")
  (register pattern-get-filter
    (Fn [(Ptr CairoPattern)] CairoFilter)
    "cairo_pattern_get_filter")

  (register pattern-status
    (Fn [(Ptr CairoPattern)] CairoStatus)
    "cairo_pattern_status")
  (doc pattern-destroy
    "Destroy a pattern created by `pattern-create-*`. Must be called after the pattern is no longer needed.")
  (register pattern-destroy (Fn [(Ptr CairoPattern)] ()) "cairo_pattern_destroy")

  ; --- Path introspection ---

  (private path-copy)
  (hidden path-copy)
  (register path-copy
    (Fn [(Ptr CairoContext)] (Ptr CairoPath))
    "cairo_copy_path")
  (private path-copy-flat)
  (hidden path-copy-flat)
  (register path-copy-flat
    (Fn [(Ptr CairoContext)] (Ptr CairoPath))
    "cairo_copy_path_flat")
  (private path-destroy)
  (hidden path-destroy)
  (register path-destroy (Fn [(Ptr CairoPath)] ()) "cairo_path_destroy")

  (private path-move-to)
  (hidden path-move-to)
  (register path-move-to Int "CAIRO_PATH_MOVE_TO")
  (private path-line-to)
  (hidden path-line-to)
  (register path-line-to Int "CAIRO_PATH_LINE_TO")
  (private path-curve-to)
  (hidden path-curve-to)
  (register path-curve-to Int "CAIRO_PATH_CURVE_TO")

  (private path-status)
  (hidden path-status)
  (deftemplate path-status
               (Fn [(Ptr CairoPath)] CairoStatus)
               "cairo_status_t $NAME(cairo_path_t *p)"
               "$DECL { return p->status; }")
  (private path-num-data)
  (hidden path-num-data)
  (deftemplate path-num-data
               (Fn [(Ptr CairoPath)] Int)
               "int $NAME(cairo_path_t *p)"
               "$DECL { return p->num_data; }")
  (private path-header-type)
  (hidden path-header-type)
  (deftemplate path-header-type
               (Fn [(Ptr CairoPath) Int] Int)
               "int $NAME(cairo_path_t *p, int i)"
               "$DECL { return (int)p->data[i].header.type; }")
  (private path-header-length)
  (hidden path-header-length)
  (deftemplate path-header-length
               (Fn [(Ptr CairoPath) Int] Int)
               "int $NAME(cairo_path_t *p, int i)"
               "$DECL { return p->data[i].header.length; }")
  (private path-point)
  (hidden path-point)
  (deftemplate path-point
               (Fn [(Ptr CairoPath) Int] CairoPoint)
               "CairoPoint $NAME(cairo_path_t *p, int i)"
               "$DECL { CairoPoint r = {.x = p->data[i].point.x, .y = p->data[i].point.y}; return r; }")

  (private path-element)
  (hidden path-element)
  (defn path-element [p i]
    (let [kind (path-header-type p i)]
      (cond
        (Int.= kind path-move-to)
          (CairoPathElement.MoveTo (path-point p (+ i 1)))
        (Int.= kind path-line-to)
          (CairoPathElement.LineTo (path-point p (+ i 1)))
        (Int.= kind path-curve-to)
          (CairoPathElement.CurveTo (path-point p (+ i 1))
                                    (path-point p (+ i 2))
                                    (path-point p (+ i 3)))
        (CairoPathElement.ClosePath))))

  (private path-elements)
  (hidden path-elements)
  (defn path-elements [p]
    (let-do [n (path-num-data p)
             elements []
             i 0]
      (while-do (< i n)
        (Array.push-back! &elements (path-element p i))
        (set! i (+ i (path-header-length p i))))
      elements))

  (private path-result)
  (hidden path-result)
  (defn path-result [p]
    (let [s (path-status p)]
      (if (success? s) (Result.Success (path-elements p)) (Result.Error s))))

  (doc copy-path
    "Return the current path as an array of `CairoPathElement`s, in user-space
coordinates, or the context's error status in the error branch.

Cairo reports a `close-path` as a `ClosePath` followed by a `MoveTo` back to the
start of the closed subpath, which is where the current point ends up; both are
surfaced as-is.")
  (defn copy-path [cr]
    (let-do [p (path-copy cr)
             r (path-result p)] (path-destroy p) r))
  (doc copy-path-flat
    "Like `copy-path`, but with every curve approximated by a series of `LineTo`
elements within tolerance. The result never contains a `CurveTo`.")
  (defn copy-path-flat [cr]
    (let-do [p (path-copy-flat cr)
             r (path-result p)] (path-destroy p) r))
  (doc append-path
    "Append `elements` to the context's current path, interpreting their
coordinates in the context's current user space.")
  (defn append-path [cr elements]
    (for [i 0 (Array.length elements)]
      (match-ref (Array.unsafe-nth elements i)
        (CairoPathElement.MoveTo p)
          (move-to cr @(CairoPoint.x p) @(CairoPoint.y p))
        (CairoPathElement.LineTo p)
          (line-to cr @(CairoPoint.x p) @(CairoPoint.y p))
        (CairoPathElement.CurveTo a b c)
          (curve-to cr
                    @(CairoPoint.x a)
                    @(CairoPoint.y a)
                    @(CairoPoint.x b)
                    @(CairoPoint.y b)
                    @(CairoPoint.x c)
                    @(CairoPoint.y c))
        (CairoPathElement.ClosePath) (close-path cr))))

  ; --- Groups ---

  (register content-color CairoContent "CAIRO_CONTENT_COLOR")
  (register content-alpha CairoContent "CAIRO_CONTENT_ALPHA")
  (register content-color-alpha CairoContent "CAIRO_CONTENT_COLOR_ALPHA")

  (doc push-group
    "Redirect drawing into an intermediate group surface, so that a whole
sequence of operations can be composited onto the target as a unit. Pairs with
`pop-group` or `pop-group-to-source`, and saves the drawing state the way `save`
does.")
  (register push-group (Fn [(Ptr CairoContext)] ()) "cairo_push_group")
  (doc push-group-with-content
    "Like `push-group`, but with the group surface's content type chosen
explicitly instead of inferred from the target.")
  (register push-group-with-content
    (Fn [(Ptr CairoContext) CairoContent] ())
    "cairo_push_group_with_content")
  (doc pop-group
    "End the innermost group and return it as a pattern, restoring the state
`push-group` saved. The pattern must be freed with `pattern-destroy`.")
  (register pop-group
    (Fn [(Ptr CairoContext)] (Ptr CairoPattern))
    "cairo_pop_group")
  (doc pop-group-to-source
    "End the innermost group and install it as the source, as `pop-group`
followed by `set-source` and `pattern-destroy` would.")
  (register pop-group-to-source
    (Fn [(Ptr CairoContext)] ())
    "cairo_pop_group_to_source")
  (doc get-group-target
    "Return the surface drawing currently goes to: the innermost group's surface,
or the context's target if no group is active. It is owned by the context and
must not be destroyed.")
  (register get-group-target
    (Fn [(Ptr CairoContext)] (Ptr CairoSurface))
    "cairo_get_group_target")

  ; --- Masks ---

  (doc mask "Paint the current source through the alpha channel of `pattern`.")
  (register mask (Fn [(Ptr CairoContext) (Ptr CairoPattern)] ()) "cairo_mask")
  (doc mask-surface
    "Paint the current source through the alpha channel of `surface`, with the
surface's origin placed at `(x y)` in user space.")
  (register mask-surface
    (Fn [(Ptr CairoContext) (Ptr CairoSurface) Double Double] ())
    "cairo_mask_surface")

  ; --- Regions ---

  (register region-overlap-in CairoRegionOverlap "CAIRO_REGION_OVERLAP_IN")
  (register region-overlap-out CairoRegionOverlap "CAIRO_REGION_OVERLAP_OUT")
  (register region-overlap-part CairoRegionOverlap "CAIRO_REGION_OVERLAP_PART")

  (doc region-create
    "Create an empty region. Must be paired with `region-destroy`.")
  (register region-create (Fn [] (Ptr CairoRegion)) "cairo_region_create")
  (doc region-create-rectangle "Create a region containing `rect`.")
  (deftemplate region-create-rectangle
               (Fn [(Ref CairoRectangleInt)] (Ptr CairoRegion))
               "cairo_region_t* $NAME(CairoRectangleInt *r)"
               "$DECL { cairo_rectangle_int_t cr = {.x = r->x, .y = r->y, .width = r->width, .height = r->height}; return cairo_region_create_rectangle(&cr); }")
  (doc region-create-rectangles "Create a region covering the union of `rects`.")
  (deftemplate region-create-rectangles
               (Fn [(Ref (Array CairoRectangleInt))] (Ptr CairoRegion))
               "cairo_region_t* $NAME(Array *rects)"
               "$DECL { int n = rects->len; cairo_rectangle_int_t *cs = NULL; if (n > 0) { cs = CARP_MALLOC(n * sizeof(cairo_rectangle_int_t)); CairoRectangleInt *src = (CairoRectangleInt*)rects->data; for (int i = 0; i < n; i++) { cs[i].x = src[i].x; cs[i].y = src[i].y; cs[i].width = src[i].width; cs[i].height = src[i].height; } } cairo_region_t *r = cairo_region_create_rectangles(cs, n); if (cs) CARP_FREE(cs); return r; }")
  (doc region-copy
    "Create an independent copy of `reg`, which must be destroyed separately.")
  (register region-copy
    (Fn [(Ptr CairoRegion)] (Ptr CairoRegion))
    "cairo_region_copy")
  (register region-destroy (Fn [(Ptr CairoRegion)] ()) "cairo_region_destroy")
  (register region-status
    (Fn [(Ptr CairoRegion)] CairoStatus)
    "cairo_region_status")

  (doc region-get-extents
    "Return the bounding box of `reg`, or a zero-sized rectangle if it is empty.")
  (deftemplate region-get-extents
               (Fn [(Ptr CairoRegion)] CairoRectangleInt)
               "CairoRectangleInt $NAME(cairo_region_t *reg)"
               "$DECL { cairo_rectangle_int_t cr; cairo_region_get_extents(reg, &cr); CairoRectangleInt r = {.x = cr.x, .y = cr.y, .width = cr.width, .height = cr.height}; return r; }")
  (doc region-num-rectangles
    "Return how many non-overlapping rectangles `reg` decomposes into.")
  (register region-num-rectangles
    (Fn [(Ptr CairoRegion)] Int)
    "cairo_region_num_rectangles")

  (private region-rectangle-at)
  (hidden region-rectangle-at)
  (deftemplate region-rectangle-at
               (Fn [(Ptr CairoRegion) Int] CairoRectangleInt)
               "CairoRectangleInt $NAME(cairo_region_t *reg, int nth)"
               "$DECL { cairo_rectangle_int_t cr; cairo_region_get_rectangle(reg, nth, &cr); CairoRectangleInt r = {.x = cr.x, .y = cr.y, .width = cr.width, .height = cr.height}; return r; }")
  (doc region-get-rectangle
    "Return the `nth` rectangle of `reg`, or `Nothing` if `nth` is out of range.")
  (defn region-get-rectangle [reg nth]
    (if (and (>= nth 0) (< nth (region-num-rectangles reg)))
      (Maybe.Just (region-rectangle-at reg nth))
      (Maybe.Nothing)))

  (doc region-empty? "Return `true` if `reg` covers nothing.")
  (deftemplate region-empty?
               (Fn [(Ptr CairoRegion)] Bool)
               "bool $NAME(cairo_region_t *reg)"
               "$DECL { return (bool)cairo_region_is_empty(reg); }")
  (doc region-contains-point?
    "Return `true` if the device-space point `(x y)` lies inside `reg`.")
  (deftemplate region-contains-point?
               (Fn [(Ptr CairoRegion) Int Int] Bool)
               "bool $NAME(cairo_region_t *reg, int x, int y)"
               "$DECL { return (bool)cairo_region_contains_point(reg, x, y); }")
  (doc region-contains-rectangle
    "Report whether `rect` is entirely inside `reg` (`region-overlap-in`),
entirely outside it (`region-overlap-out`), or straddles its edge
(`region-overlap-part`).")
  (deftemplate region-contains-rectangle
               (Fn
                 [(Ptr CairoRegion) (Ref CairoRectangleInt)]
                 CairoRegionOverlap)
               "cairo_region_overlap_t $NAME(cairo_region_t *reg, CairoRectangleInt *r)"
               "$DECL { cairo_rectangle_int_t cr = {.x = r->x, .y = r->y, .width = r->width, .height = r->height}; return cairo_region_contains_rectangle(reg, &cr); }")
  (doc region-equal? "Return `true` if `a` and `b` cover the same area.")
  (deftemplate region-equal?
               (Fn [(Ptr CairoRegion) (Ptr CairoRegion)] Bool)
               "bool $NAME(cairo_region_t *a, cairo_region_t *b)"
               "$DECL { return (bool)cairo_region_equal(a, b); }")
  (doc region-translate "Move `reg` by `(dx dy)` in device space.")
  (register region-translate
    (Fn [(Ptr CairoRegion) Int Int] ())
    "cairo_region_translate")

  (doc region-intersect
    "Reduce `reg` to its intersection with `other`, returning a `CairoStatus`.")
  (register region-intersect
    (Fn [(Ptr CairoRegion) (Ptr CairoRegion)] CairoStatus)
    "cairo_region_intersect")
  (doc region-intersect-rectangle
    "Reduce `reg` to its intersection with `rect`, returning a `CairoStatus`.")
  (deftemplate region-intersect-rectangle
               (Fn [(Ptr CairoRegion) (Ref CairoRectangleInt)] CairoStatus)
               "cairo_status_t $NAME(cairo_region_t *reg, CairoRectangleInt *r)"
               "$DECL { cairo_rectangle_int_t cr = {.x = r->x, .y = r->y, .width = r->width, .height = r->height}; return cairo_region_intersect_rectangle(reg, &cr); }")
  (doc region-subtract "Subtract `other` from `reg`, returning a `CairoStatus`.")
  (register region-subtract
    (Fn [(Ptr CairoRegion) (Ptr CairoRegion)] CairoStatus)
    "cairo_region_subtract")
  (doc region-subtract-rectangle
    "Subtract `rect` from `reg`, returning a `CairoStatus`.")
  (deftemplate region-subtract-rectangle
               (Fn [(Ptr CairoRegion) (Ref CairoRectangleInt)] CairoStatus)
               "cairo_status_t $NAME(cairo_region_t *reg, CairoRectangleInt *r)"
               "$DECL { cairo_rectangle_int_t cr = {.x = r->x, .y = r->y, .width = r->width, .height = r->height}; return cairo_region_subtract_rectangle(reg, &cr); }")
  (doc region-union
    "Grow `reg` to also cover `other`, returning a `CairoStatus`.")
  (register region-union
    (Fn [(Ptr CairoRegion) (Ptr CairoRegion)] CairoStatus)
    "cairo_region_union")
  (doc region-union-rectangle
    "Grow `reg` to also cover `rect`, returning a `CairoStatus`.")
  (deftemplate region-union-rectangle
               (Fn [(Ptr CairoRegion) (Ref CairoRectangleInt)] CairoStatus)
               "cairo_status_t $NAME(cairo_region_t *reg, CairoRectangleInt *r)"
               "$DECL { cairo_rectangle_int_t cr = {.x = r->x, .y = r->y, .width = r->width, .height = r->height}; return cairo_region_union_rectangle(reg, &cr); }")
  (doc region-xor
    "Reduce `reg` to the area covered by exactly one of `reg` and `other`,
returning a `CairoStatus`.")
  (register region-xor
    (Fn [(Ptr CairoRegion) (Ptr CairoRegion)] CairoStatus)
    "cairo_region_xor")
  (doc region-xor-rectangle
    "Reduce `reg` to the area covered by exactly one of `reg` and `rect`,
returning a `CairoStatus`.")
  (deftemplate region-xor-rectangle
               (Fn [(Ptr CairoRegion) (Ref CairoRectangleInt)] CairoStatus)
               "cairo_status_t $NAME(cairo_region_t *reg, CairoRectangleInt *r)"
               "$DECL { cairo_rectangle_int_t cr = {.x = r->x, .y = r->y, .width = r->width, .height = r->height}; return cairo_region_xor_rectangle(reg, &cr); }"))

(defmodule CairoRegionOverlap
  (doc =
    "Equality on region overlap values, implemented by converting to `Int` first.")
  (defn = [a b]
    (Int.= (enum-to-int (the CairoRegionOverlap a))
           (enum-to-int (the CairoRegionOverlap b))))
  (implements = CairoRegionOverlap.=))
