(system-include "cairo.h")
(system-include "cairo-pdf.h")
(system-include "cairo-svg.h")

(posix-only (add-pkg "cairo"))

(register-type CairoContext "cairo_t")
(register-type CairoSurface "cairo_surface_t")
(register-type CairoPattern "cairo_pattern_t")

; Registered as distinct Carp types so the constants don't collide with Int.
(register-type CairoStatus "cairo_status_t")
(register-type CairoFormat "cairo_format_t")
(register-type CairoAntialias "cairo_antialias_t")
(register-type CairoLineCap "cairo_line_cap_t")
(register-type CairoLineJoin "cairo_line_join_t")
(register-type CairoFillRule "cairo_fill_rule_t")
(register-type CairoOperator "cairo_operator_t")
(register-type CairoFontSlant "cairo_font_slant_t")
(register-type CairoFontWeight "cairo_font_weight_t")
(register-type CairoExtend "cairo_extend_t")
(register-type CairoFilter "cairo_filter_t")

(doc CairoExtents
  "Axis-aligned bounding box returned by `fill-extents`, `stroke-extents`, and `path-extents`.")
(deftype CairoExtents [x1 Double
                       y1 Double
                       x2 Double
                       y2 Double])
(doc CairoTextExtents
  "Text measurement returned by `text-extents`: bearing, ink size, and advance.")
(deftype CairoTextExtents
  [x-bearing Double
   y-bearing Double
   width Double
   height Double
   x-advance Double
   y-advance Double])
(doc CairoFontExtents
  "Font-level metrics returned by `font-extents`: ascent, descent, height, and maximum advances.")
(deftype CairoFontExtents
  [ascent Double
   descent Double
   height Double
   max-x-advance Double
   max-y-advance Double])

(doc Cairo
  "Thin FFI bindings over the [Cairo 2D graphics library](https://www.cairographics.org/).

The goal of this module is to expose Cairo's C API with Carp-friendly naming (kebab-case, grouped under `Cairo`), without adding a higher-level wrapper on top. Higher-level sketching primitives live in [anima.carp](https://github.com/carpentry-org/anima.carp).

## Installation

Cairo must be installed on the system and discoverable via `pkg-config`:

```
brew install cairo        # macOS
apt install libcairo2-dev # Debian / Ubuntu
```

## Example

```clojure
(load \"git@github.com:carpentry-org/cairo.carp@0.2.0\")

(defn main []
  (let-do [surf (Cairo.image-surface-create Cairo.format-argb32 200 200)
           cr (Cairo.create surf)]
    (Cairo.set-source-rgb cr 1.0 1.0 1.0)
    (Cairo.paint cr)
    (Cairo.set-source-rgb cr 0.0 0.0 0.0)
    (Cairo.set-line-width cr 4.0)
    (Cairo.move-to cr 20.0 20.0)
    (Cairo.line-to cr 180.0 180.0)
    (Cairo.stroke cr)
    (ignore (Cairo.surface-write-to-png surf (cstr \"out.png\")))
    (Cairo.destroy cr)
    (Cairo.surface-destroy surf)))
```

## Memory management

Cairo uses reference counting internally; this binding does not manage
lifetimes for you. Every `Cairo.create` must be paired with a `Cairo.destroy`,
and every `*-surface-create` with a `Cairo.surface-destroy`. See the [Cairo
manual](https://www.cairographics.org/manual/) for details.")
(defmodule Cairo
  (doc status-success "Success status code returned by most Cairo operations.")
  (register status-success CairoStatus "CAIRO_STATUS_SUCCESS")
  (register status-to-string
    (Fn [CairoStatus] (Ptr CChar))
    "cairo_status_to_string")

  (doc = "Equality on status codes, implemented by converting to `Int` first.")
  (defn = [a b]
    (Int.= (enum-to-int (the CairoStatus a)) (enum-to-int (the CairoStatus b))))
  (implements = Cairo.=)

  (doc success? "Returns `true` if the given status equals `status-success`.")
  (defn success? [s] (Cairo.= s status-success))

  (doc format-argb32
    "32-bit ARGB, native-endian. Matches `SDL_PIXELFORMAT_ARGB8888` on little-endian.")
  (register format-argb32 CairoFormat "CAIRO_FORMAT_ARGB32")
  (register format-rgb24 CairoFormat "CAIRO_FORMAT_RGB24")
  (register format-a8 CairoFormat "CAIRO_FORMAT_A8")
  (register format-a1 CairoFormat "CAIRO_FORMAT_A1")

  (register antialias-default CairoAntialias "CAIRO_ANTIALIAS_DEFAULT")
  (register antialias-none CairoAntialias "CAIRO_ANTIALIAS_NONE")
  (register antialias-gray CairoAntialias "CAIRO_ANTIALIAS_GRAY")
  (register antialias-subpixel CairoAntialias "CAIRO_ANTIALIAS_SUBPIXEL")
  (register antialias-fast CairoAntialias "CAIRO_ANTIALIAS_FAST")
  (register antialias-good CairoAntialias "CAIRO_ANTIALIAS_GOOD")
  (register antialias-best CairoAntialias "CAIRO_ANTIALIAS_BEST")

  (register line-cap-butt CairoLineCap "CAIRO_LINE_CAP_BUTT")
  (register line-cap-round CairoLineCap "CAIRO_LINE_CAP_ROUND")
  (register line-cap-square CairoLineCap "CAIRO_LINE_CAP_SQUARE")

  (register line-join-miter CairoLineJoin "CAIRO_LINE_JOIN_MITER")
  (register line-join-round CairoLineJoin "CAIRO_LINE_JOIN_ROUND")
  (register line-join-bevel CairoLineJoin "CAIRO_LINE_JOIN_BEVEL")

  (register fill-rule-winding CairoFillRule "CAIRO_FILL_RULE_WINDING")
  (register fill-rule-even-odd CairoFillRule "CAIRO_FILL_RULE_EVEN_ODD")

  (register operator-clear CairoOperator "CAIRO_OPERATOR_CLEAR")
  (register operator-source CairoOperator "CAIRO_OPERATOR_SOURCE")
  (register operator-over CairoOperator "CAIRO_OPERATOR_OVER")
  (register operator-in CairoOperator "CAIRO_OPERATOR_IN")
  (register operator-out CairoOperator "CAIRO_OPERATOR_OUT")
  (register operator-atop CairoOperator "CAIRO_OPERATOR_ATOP")
  (register operator-dest CairoOperator "CAIRO_OPERATOR_DEST")
  (register operator-dest-over CairoOperator "CAIRO_OPERATOR_DEST_OVER")
  (register operator-dest-in CairoOperator "CAIRO_OPERATOR_DEST_IN")
  (register operator-dest-out CairoOperator "CAIRO_OPERATOR_DEST_OUT")
  (register operator-dest-atop CairoOperator "CAIRO_OPERATOR_DEST_ATOP")
  (register operator-xor CairoOperator "CAIRO_OPERATOR_XOR")
  (register operator-add CairoOperator "CAIRO_OPERATOR_ADD")
  (register operator-multiply CairoOperator "CAIRO_OPERATOR_MULTIPLY")
  (register operator-screen CairoOperator "CAIRO_OPERATOR_SCREEN")

  (register slant-normal CairoFontSlant "CAIRO_FONT_SLANT_NORMAL")
  (register slant-italic CairoFontSlant "CAIRO_FONT_SLANT_ITALIC")
  (register slant-oblique CairoFontSlant "CAIRO_FONT_SLANT_OBLIQUE")
  (register weight-normal CairoFontWeight "CAIRO_FONT_WEIGHT_NORMAL")
  (register weight-bold CairoFontWeight "CAIRO_FONT_WEIGHT_BOLD")

  (doc image-surface-create
    "Create an in-memory image surface of the given format, width, and height.")
  (register image-surface-create
    (Fn [CairoFormat Int Int] (Ptr CairoSurface))
    "cairo_image_surface_create")
  (doc pdf-surface-create
    "Create a PDF surface writing to `filename` with dimensions in points (1 point = 1/72 inch).")
  (register pdf-surface-create
    (Fn [(Ptr CChar) Double Double] (Ptr CairoSurface))
    "cairo_pdf_surface_create")
  (doc svg-surface-create
    "Create an SVG surface writing to `filename` with dimensions in points.")
  (register svg-surface-create
    (Fn [(Ptr CChar) Double Double] (Ptr CairoSurface))
    "cairo_svg_surface_create")

  (doc image-surface-get-data
    "Return a raw pointer to the surface's pixel buffer. Must be preceded by `surface-flush`.")
  (register image-surface-get-data
    (Fn [(Ptr CairoSurface)] (Ptr Byte))
    "cairo_image_surface_get_data")
  (register image-surface-get-stride
    (Fn [(Ptr CairoSurface)] Int)
    "cairo_image_surface_get_stride")
  (register image-surface-get-width
    (Fn [(Ptr CairoSurface)] Int)
    "cairo_image_surface_get_width")
  (register image-surface-get-height
    (Fn [(Ptr CairoSurface)] Int)
    "cairo_image_surface_get_height")

  (register surface-destroy (Fn [(Ptr CairoSurface)] ()) "cairo_surface_destroy")
  (doc surface-flush
    "Ensure pending drawing for the surface has been applied. Required before reading pixels directly.")
  (register surface-flush (Fn [(Ptr CairoSurface)] ()) "cairo_surface_flush")
  (register surface-finish (Fn [(Ptr CairoSurface)] ()) "cairo_surface_finish")
  (register surface-status
    (Fn [(Ptr CairoSurface)] CairoStatus)
    "cairo_surface_status")
  (doc surface-write-to-png
    "Write the contents of an image surface to a PNG file. Returns a `CairoStatus`.")
  (register surface-write-to-png
    (Fn [(Ptr CairoSurface) (Ptr CChar)] CairoStatus)
    "cairo_surface_write_to_png")
  (doc image-surface-create-from-png
    "Load a PNG file into a new image surface. Must be paired with `surface-destroy`.")
  (register image-surface-create-from-png
    (Fn [(Ptr CChar)] (Ptr CairoSurface))
    "cairo_image_surface_create_from_png")

  (doc create
    "Create a drawing context targeting the given surface. Must be paired with `destroy`.")
  (register create (Fn [(Ptr CairoSurface)] (Ptr CairoContext)) "cairo_create")
  (register destroy (Fn [(Ptr CairoContext)] ()) "cairo_destroy")
  (register status (Fn [(Ptr CairoContext)] CairoStatus) "cairo_status")
  (doc save "Push a copy of the current drawing state onto an internal stack.")
  (register save (Fn [(Ptr CairoContext)] ()) "cairo_save")
  (doc restore "Pop the top drawing state off the stack and make it current.")
  (register restore (Fn [(Ptr CairoContext)] ()) "cairo_restore")

  (register translate
    (Fn [(Ptr CairoContext) Double Double] ())
    "cairo_translate")
  (doc rotate "Rotate the current transformation by `angle` radians.")
  (register rotate (Fn [(Ptr CairoContext) Double] ()) "cairo_rotate")
  (register scale (Fn [(Ptr CairoContext) Double Double] ()) "cairo_scale")
  (register identity-matrix (Fn [(Ptr CairoContext)] ()) "cairo_identity_matrix")

  (register new-path (Fn [(Ptr CairoContext)] ()) "cairo_new_path")
  (register new-sub-path (Fn [(Ptr CairoContext)] ()) "cairo_new_sub_path")
  (register move-to (Fn [(Ptr CairoContext) Double Double] ()) "cairo_move_to")
  (register line-to (Fn [(Ptr CairoContext) Double Double] ()) "cairo_line_to")
  (doc curve-to
    "Append a cubic Bézier spline through `(x1 y1)`, `(x2 y2)`, `(x3 y3)`.")
  (register curve-to
    (Fn [(Ptr CairoContext) Double Double Double Double Double Double] ())
    "cairo_curve_to")
  (register rel-move-to
    (Fn [(Ptr CairoContext) Double Double] ())
    "cairo_rel_move_to")
  (register rel-line-to
    (Fn [(Ptr CairoContext) Double Double] ())
    "cairo_rel_line_to")
  (register rel-curve-to
    (Fn [(Ptr CairoContext) Double Double Double Double Double Double] ())
    "cairo_rel_curve_to")
  (doc arc
    "Add a circular arc centered at `(xc yc)` with `radius`, sweeping from `angle1` to `angle2` radians (positive = clockwise in Cairo's default orientation).")
  (register arc
    (Fn [(Ptr CairoContext) Double Double Double Double Double] ())
    "cairo_arc")
  (register arc-negative
    (Fn [(Ptr CairoContext) Double Double Double Double Double] ())
    "cairo_arc_negative")
  (register rectangle
    (Fn [(Ptr CairoContext) Double Double Double Double] ())
    "cairo_rectangle")
  (register close-path (Fn [(Ptr CairoContext)] ()) "cairo_close_path")

  (doc has-current-point?
    "Return `true` if the context has a current point (after `move-to` or drawing operations).")
  (deftemplate has-current-point?
               (Fn [(Ptr CairoContext)] Bool)
               "bool $NAME(cairo_t *cr)"
               "$DECL { return (bool)cairo_has_current_point(cr); }")
  (doc get-current-point-x
    "Return the x coordinate of the current point. Undefined if `has-current-point?` is false.")
  (deftemplate get-current-point-x
               (Fn [(Ptr CairoContext)] Double)
               "double $NAME(cairo_t *cr)"
               "$DECL { double x, y; cairo_get_current_point(cr, &x, &y); return x; }")
  (doc get-current-point-y
    "Return the y coordinate of the current point. Undefined if `has-current-point?` is false.")
  (deftemplate get-current-point-y
               (Fn [(Ptr CairoContext)] Double)
               "double $NAME(cairo_t *cr)"
               "$DECL { double x, y; cairo_get_current_point(cr, &x, &y); return y; }")

  (register stroke (Fn [(Ptr CairoContext)] ()) "cairo_stroke")
  (register stroke-preserve (Fn [(Ptr CairoContext)] ()) "cairo_stroke_preserve")
  (register fill (Fn [(Ptr CairoContext)] ()) "cairo_fill")
  (register fill-preserve (Fn [(Ptr CairoContext)] ()) "cairo_fill_preserve")
  (doc paint
    "Paint the current source everywhere within the current clip region.")
  (register paint (Fn [(Ptr CairoContext)] ()) "cairo_paint")
  (register paint-with-alpha
    (Fn [(Ptr CairoContext) Double] ())
    "cairo_paint_with_alpha")
  (register clip (Fn [(Ptr CairoContext)] ()) "cairo_clip")
  (register clip-preserve (Fn [(Ptr CairoContext)] ()) "cairo_clip_preserve")
  (register reset-clip (Fn [(Ptr CairoContext)] ()) "cairo_reset_clip")

  (doc fill-extents
    "Compute the bounding box of the area that would be affected by `fill`.")
  (deftemplate fill-extents
               (Fn [(Ptr CairoContext)] CairoExtents)
               "CairoExtents $NAME(cairo_t *cr)"
               "$DECL { CairoExtents e; cairo_fill_extents(cr, &e.x1, &e.y1, &e.x2, &e.y2); return e; }")
  (doc stroke-extents
    "Compute the bounding box of the area that would be affected by `stroke`.")
  (deftemplate stroke-extents
               (Fn [(Ptr CairoContext)] CairoExtents)
               "CairoExtents $NAME(cairo_t *cr)"
               "$DECL { CairoExtents e; cairo_stroke_extents(cr, &e.x1, &e.y1, &e.x2, &e.y2); return e; }")
  (doc path-extents
    "Compute the bounding box enclosing the current path, ignoring stroke parameters.")
  (deftemplate path-extents
               (Fn [(Ptr CairoContext)] CairoExtents)
               "CairoExtents $NAME(cairo_t *cr)"
               "$DECL { CairoExtents e; cairo_path_extents(cr, &e.x1, &e.y1, &e.x2, &e.y2); return e; }")

  (register set-source-rgb
    (Fn [(Ptr CairoContext) Double Double Double] ())
    "cairo_set_source_rgb")
  (register set-source-rgba
    (Fn [(Ptr CairoContext) Double Double Double Double] ())
    "cairo_set_source_rgba")
  (register set-line-width
    (Fn [(Ptr CairoContext) Double] ())
    "cairo_set_line_width")
  (register set-line-cap
    (Fn [(Ptr CairoContext) CairoLineCap] ())
    "cairo_set_line_cap")
  (register set-line-join
    (Fn [(Ptr CairoContext) CairoLineJoin] ())
    "cairo_set_line_join")
  (register set-operator
    (Fn [(Ptr CairoContext) CairoOperator] ())
    "cairo_set_operator")
  (register set-antialias
    (Fn [(Ptr CairoContext) CairoAntialias] ())
    "cairo_set_antialias")
  (register set-fill-rule
    (Fn [(Ptr CairoContext) CairoFillRule] ())
    "cairo_set_fill_rule")

  (doc set-dash
    "Set the dash pattern. `dashes` is an array of on/off lengths; `offset` shifts the pattern start.")
  (deftemplate set-dash
               (Fn [(Ptr CairoContext) (Ref (Array Double)) Double] ())
               "void $NAME(cairo_t *cr, Array *dashes, double offset)"
               "$DECL { cairo_set_dash(cr, (double*)dashes->data, dashes->len, offset); }")
  (doc get-dash-count
    "Return the number of dash segments in the current dash pattern (0 means solid).")
  (register get-dash-count (Fn [(Ptr CairoContext)] Int) "cairo_get_dash_count")
  (doc get-dash "Return the current dash pattern as an array of doubles.")
  (deftemplate get-dash
               (Fn [(Ptr CairoContext)] (Array Double))
               "Array $NAME(cairo_t *cr)"
               "$DECL { int n = cairo_get_dash_count(cr); Array a; a.len = n; a.capacity = n; if (n > 0) { a.data = CARP_MALLOC(n * sizeof(double)); cairo_get_dash(cr, (double*)a.data, NULL); } else { a.data = NULL; } return a; }")
  (doc get-dash-offset
    "Return the offset into the dash pattern set by `set-dash`.")
  (deftemplate get-dash-offset
               (Fn [(Ptr CairoContext)] Double)
               "double $NAME(cairo_t *cr)"
               "$DECL { double offset; cairo_get_dash(cr, NULL, &offset); return offset; }")

  (doc set-source-surface
    "Set a surface as the source pattern, translated to `(x y)`.")
  (register set-source-surface
    (Fn [(Ptr CairoContext) (Ptr CairoSurface) Double Double] ())
    "cairo_set_source_surface")

  (doc select-font-face
    "Select a font face by family name, slant, and weight. Uses Cairo's built-in toy text API.")
  (register select-font-face
    (Fn [(Ptr CairoContext) (Ptr CChar) CairoFontSlant CairoFontWeight] ())
    "cairo_select_font_face")
  (register set-font-size
    (Fn [(Ptr CairoContext) Double] ())
    "cairo_set_font_size")
  (register show-text (Fn [(Ptr CairoContext) (Ptr CChar)] ()) "cairo_show_text")

  (doc text-extents
    "Measure `text` and return a `CairoTextExtents` with bearing, size, and advance fields.")
  (deftemplate text-extents
               (Fn [(Ptr CairoContext) (Ptr CChar)] CairoTextExtents)
               "CairoTextExtents $NAME(cairo_t *cr, const char *text)"
               "$DECL { cairo_text_extents_t ct; cairo_text_extents(cr, text, &ct); CairoTextExtents e; e.x_MINUS_bearing = ct.x_bearing; e.y_MINUS_bearing = ct.y_bearing; e.width = ct.width; e.height = ct.height; e.x_MINUS_advance = ct.x_advance; e.y_MINUS_advance = ct.y_advance; return e; }")
  (doc font-extents
    "Return a `CairoFontExtents` for the current font (ascent, descent, height, max advances).")
  (deftemplate font-extents
               (Fn [(Ptr CairoContext)] CairoFontExtents)
               "CairoFontExtents $NAME(cairo_t *cr)"
               "$DECL { cairo_font_extents_t cf; cairo_font_extents(cr, &cf); CairoFontExtents e; e.ascent = cf.ascent; e.descent = cf.descent; e.height = cf.height; e.max_MINUS_x_MINUS_advance = cf.max_x_advance; e.max_MINUS_y_MINUS_advance = cf.max_y_advance; return e; }")

  ; --- Pattern / gradient bindings ---

  (register extend-none CairoExtend "CAIRO_EXTEND_NONE")
  (register extend-repeat CairoExtend "CAIRO_EXTEND_REPEAT")
  (register extend-reflect CairoExtend "CAIRO_EXTEND_REFLECT")
  (register extend-pad CairoExtend "CAIRO_EXTEND_PAD")

  (register filter-fast CairoFilter "CAIRO_FILTER_FAST")
  (register filter-good CairoFilter "CAIRO_FILTER_GOOD")
  (register filter-best CairoFilter "CAIRO_FILTER_BEST")
  (register filter-nearest CairoFilter "CAIRO_FILTER_NEAREST")
  (register filter-bilinear CairoFilter "CAIRO_FILTER_BILINEAR")

  (doc pattern-create-linear
    "Create a linear gradient pattern along the line from `(x0 y0)` to `(x1 y1)`.")
  (register pattern-create-linear
    (Fn [Double Double Double Double] (Ptr CairoPattern))
    "cairo_pattern_create_linear")
  (doc pattern-create-radial
    "Create a radial gradient between two circles: center `(cx0 cy0)` radius `r0` and center `(cx1 cy1)` radius `r1`.")
  (register pattern-create-radial
    (Fn [Double Double Double Double Double Double] (Ptr CairoPattern))
    "cairo_pattern_create_radial")
  (doc pattern-create-for-surface
    "Create a pattern from a surface, useful for tiling or compositing.")
  (register pattern-create-for-surface
    (Fn [(Ptr CairoSurface)] (Ptr CairoPattern))
    "cairo_pattern_create_for_surface")

  (doc pattern-add-color-stop-rgb
    "Add an opaque color stop at `offset` (0.0–1.0) to a gradient pattern.")
  (register pattern-add-color-stop-rgb
    (Fn [(Ptr CairoPattern) Double Double Double Double] ())
    "cairo_pattern_add_color_stop_rgb")
  (doc pattern-add-color-stop-rgba
    "Add a translucent color stop at `offset` (0.0–1.0) to a gradient pattern.")
  (register pattern-add-color-stop-rgba
    (Fn [(Ptr CairoPattern) Double Double Double Double Double] ())
    "cairo_pattern_add_color_stop_rgba")

  (doc set-source
    "Set the pattern as the source for subsequent drawing operations.")
  (register set-source
    (Fn [(Ptr CairoContext) (Ptr CairoPattern)] ())
    "cairo_set_source")

  (register pattern-set-extend
    (Fn [(Ptr CairoPattern) CairoExtend] ())
    "cairo_pattern_set_extend")
  (register pattern-get-extend
    (Fn [(Ptr CairoPattern)] CairoExtend)
    "cairo_pattern_get_extend")
  (register pattern-set-filter
    (Fn [(Ptr CairoPattern) CairoFilter] ())
    "cairo_pattern_set_filter")
  (register pattern-get-filter
    (Fn [(Ptr CairoPattern)] CairoFilter)
    "cairo_pattern_get_filter")

  (register pattern-status
    (Fn [(Ptr CairoPattern)] CairoStatus)
    "cairo_pattern_status")
  (doc pattern-destroy
    "Destroy a pattern created by `pattern-create-*`. Must be called after the pattern is no longer needed.")
  (register pattern-destroy (Fn [(Ptr CairoPattern)] ()) "cairo_pattern_destroy"))
